<?xml version="1.0" encoding="utf-8"?>
<!-- 对照桌面 pack_menu_chrome：彩虹外框 + 奶油内芯 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menuChrome"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:padding="0dp">

    <com.vpet.mobile.RainbowBandView
        android:layout_width="match_parent"
        android:layout_height="5dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.vpet.mobile.RainbowBandView
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:tag="left" />

        <LinearLayout
            android:id="@+id/menuRoot"
            android:layout_width="248dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/menu_bg"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/moduleRow"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical" />

            <com.vpet.mobile.PixelDividerView
                android:id="@+id/menuDivider"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/subList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/btnMenuClose"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="收起"
                android:textColor="@color/menu_fg"
                android:textSize="13sp"
                android:background="@color/menu_item_bg" />
        </LinearLayout>

        <com.vpet.mobile.RainbowBandView
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:tag="right" />
    </LinearLayout>

    <com.vpet.mobile.RainbowBandView
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:tag="bottom" />
</LinearLayout>
